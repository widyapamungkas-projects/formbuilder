# Copy to .env. `.\dev.ps1 init` does this for you and fills the change_me_* secrets.
# NEVER commit .env (it is git-ignored).

# --- App ---
APP_NAME=opnForm
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
FRONTEND_URL=http://localhost:5173

# --- Host ports (change if they clash with something on your PC) ---
API_PORT=8000
FRONTEND_PORT=5173
DB_PORT_HOST=3307
NEXTCLOUD_PORT=8080

# --- MySQL ---
DB_DATABASE=opnform
DB_USERNAME=opnform
DB_PASSWORD=change_me_db
DB_ROOT_PASSWORD=change_me_root

# --- Local Nextcloud for integration tests (optional: .\dev.ps1 nextcloud) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_nc
